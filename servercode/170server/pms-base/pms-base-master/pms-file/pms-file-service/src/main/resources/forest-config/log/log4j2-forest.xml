<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" monitorInterval="10">
    <!-- ============================================================ 全局参数定义 ============================================================ -->
    <properties>
        <!-- log输出文件的目录 -->
        <property name="LOG_HOME">${sys:forestLogPath}/forest-log/</property>
        <property name="PROJECT_NAME">${sys:forest.project.name}</property>
        <property name="FILE_NAME">${LOG_HOME}${PROJECT_NAME}/${PROJECT_NAME}_fullLog.log</property>Rollover
        <property name="ROLLOVER_MAX">9999</property>
        <!--        <property name="CACHE_LOG">cacheLogs/</property>-->
        <!-- 异常最低等级，forest的异常等级为[warn,error,fatal] -->
        <property name="EXCEPTION_LEVEL_LOWEST">WARN</property>
        <property name="CONSOLE_LEVEL_LOWEST">INFO</property>
        <property name="ZIP_SIZE">2.6GB</property>
        <!-- 文件的时间是项目启动的时间 -->
        <property name="FILE_PATTERN">
            ${LOG_HOME}${PROJECT_NAME}/year-${date:yyyy}/month-${date:MM}/day-${date:dd}/hour-${date:HH}/%d{yyyy-MM-dd_HH}~%i_${PROJECT_NAME}_fullLog.zip
        </property>
        <property name="LOGGER_LEVEL">[%-6p] &lt;</property>
        <property name="THREAD">%-9.11t&gt;</property>
        <property name="CURRENT_TIME">` | %-12d |</property>
        <property name="LOG_MESSAGE">%58marker%28x——&gt; %m&lt;——————&gt;%X%n</property>
        <property name="LOG_LOCATION_FLAG">` =&gt;</property>
        <property name="LOG_LOCATION">%l%n</property>
    </properties>
    <!-- ============================================================= 复合过滤器 ============================================================= -->
    <!--    <Filters>-->
    <!--        &lt;!&ndash; 突发过滤器 level及以下的等级会被抑制&ndash;&gt;-->
    <!--        <BurstFilter level="INFO" rate="2600" maxBurst="26000"/>-->
    <!--    </Filters>-->
    <!-- ============================================================ SyncAppends ========================================================== -->
    <Appenders>
        <!--控制台输出 -->
        <!--这个信息输出控制台的配置(信息打印) -->
        <Console name="ForestBaseConsole" target="SYSTEM_ERR">
            <ThresholdFilter level="${CONSOLE_LEVEL_LOWEST}" onMatch="ACCEPT" onMismatch="DENY"/>
            <!--输出日志的格式 -->
            <!-- 彩色打印 -->
            <PatternLayout
                    pattern="%n%highlight{${LOGGER_LEVEL}${THREAD}}${CURRENT_TIME}%highlight{${LOG_MESSAGE}${LOG_LOCATION_FLAG}} ${LOG_LOCATION}"/>
        </Console>
        <!-- 这个异常信息输出控制台的配置(打印异常信息) -->
        <Console name="ForestExceptionConsole" target="SYSTEM_ERR">
            <!-- forest的异常等级为[warn,error,fatal] -->
            <ThresholdFilter level="${CONSOLE_LEVEL_LOWEST}" onMatch="ACCEPT" onMismatch="DENY"/>
            <!--输出日志的格式 -->
            <!-- 彩色打印 -->
            <PatternLayout pattern="%highlight{%m%n}"/>
        </Console>
        <!-- 这个框架信息的输出(打印框架输出的信息)spring默认框架日志logger的name为root -->
        <Console name="ForestFrameWorkConsole" target="SYSTEM_ERR">
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <!--输出日志的格式 -->
            <PatternLayout pattern="- %-12d - %highlight{[%-6p] %-12.62t} [%c] --- %highlight{%m%n}"/>
        </Console>
        <!-- forest内部框架打印 -->
        <Console name="ForestInnerConsole" target="SYSTEM_ERR">
            <ThresholdFilter level="${CONSOLE_LEVEL_LOWEST}" onMatch="ACCEPT" onMismatch="DENY"/>
            <!--输出日志的格式 -->
            <PatternLayout pattern="%highlight{%m%n}"/>
        </Console>
        <!--文件输出滚动信息【滚动信息】 -->
        <!-- 这个会打印出所有的信息，每次大小超过size，则这size大小的日志会自动存入按年份-月份建立的文件夹下面并进行压缩，作为存档 -->
        <RollingFile name="ForestBaseRollingFile" fileName="${FILE_NAME}"
                     filePattern="${FILE_PATTERN}">
            <Policies>
                <!-- 防止空翻转 -->
                <OnStartupTriggeringPolicy/>
                <!-- 配合 filePattern 实行每天翻转  -->
                <TimeBasedTriggeringPolicy modulate="true" interval="1"/>
                <!-- 设置翻转文件大小上限 -->
                <SizeBasedTriggeringPolicy size="${ZIP_SIZE}"/>
            </Policies>
            <PatternLayout pattern="${LOGGER_LEVEL}${THREAD}${CURRENT_TIME}${LOG_MESSAGE}${LOG_LOCATION_FLAG} ${LOG_LOCATION}"/>
            <!-- DefaultRolloverStrategy属性如不设置，则默认为最多同一文件夹下7个文件，这里设置了9999 -->
            <DefaultRolloverStrategy max="${ROLLOVER_MAX}"/>
        </RollingFile>
        <RollingFile name="ForestExceptionRollingFile" fileName="${FILE_NAME}"
                     filePattern="${FILE_PATTERN}">
            <PatternLayout pattern="%m%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy modulate="true" interval="1"/>
                <SizeBasedTriggeringPolicy size="${ZIP_SIZE}"/>
            </Policies>
            <DefaultRolloverStrategy max="${ROLLOVER_MAX}"/>
        </RollingFile>
        <RollingFile name="ForestFrameWorkRollingFile" fileName="${FILE_NAME}"
                     filePattern="${FILE_PATTERN}">
            <PatternLayout pattern="- %-12d - [%-6p] %-12.62t [%c] --- %m%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy modulate="true" interval="1"/>
                <SizeBasedTriggeringPolicy size="${ZIP_SIZE}"/>
            </Policies>
            <DefaultRolloverStrategy max="${ROLLOVER_MAX}"/>
        </RollingFile>
        <RollingFile name="ForestInnerRollingFile" fileName="${FILE_NAME}"
                     filePattern="${FILE_PATTERN}">
            <PatternLayout pattern="%m%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy modulate="true" interval="1"/>
                <SizeBasedTriggeringPolicy size="${ZIP_SIZE}"/>
            </Policies>
            <DefaultRolloverStrategy max="${ROLLOVER_MAX}"/>
        </RollingFile>
        <!--        &lt;!&ndash;文件输出运行缓存信息【运行缓存信息】 &ndash;&gt;-->
        <!--        &lt;!&ndash;文件会打印出所有信息，这个log每次运行程序会自动清空，由append属性决定，这个也挺有用的，适合临时测试用 &ndash;&gt;-->
        <!--        &lt;!&ndash; 测试时打开，运行时关闭 &ndash;&gt;-->
        <!--        <File name="ForestBaseCacheFile" fileName="${LOG_HOME}${CACHE_LOG}cacheLog.log">-->
        <!--            <PatternLayout pattern="${LOGGER_LEVEL}${THREAD}${CURRENT_TIME}${LOG_MESSAGE}${LOG_LOCATION}"/>-->
        <!--        </File>-->
        <!--        <File name="ForestExceptionCacheFile" fileName="${LOG_HOME}${CACHE_LOG}cacheLog.log">-->
        <!--            <PatternLayout pattern="%m%n"/>-->
        <!--        </File>-->
        <!--        <File name="ForestFrameWorkCacheFile" fileName="${LOG_HOME}${CACHE_LOG}cacheLog.log">-->
        <!--            <PatternLayout pattern="%m%n"/>-->
        <!--        </File>-->
        <!-- ============================================================ AsyncAppends ========================================================== -->
        <Async name="AsyncFrameWork">
            <appender-ref ref="ForestFrameWorkConsole"/>
            <appender-ref ref="ForestFrameWorkRollingFile"/>
            <!--            <appender-ref ref="ForestFrameWorkCacheFile"/>-->
        </Async>
        <Async name="AsyncInner">
            <appender-ref ref="ForestInnerConsole"/>
            <appender-ref ref="ForestInnerRollingFile"/>
            <!--            <appender-ref ref="ForestInnerCacheFile"/>-->
        </Async>
        <Async name="AsyncBase">
            <appender-ref ref="ForestBaseConsole"/>
            <appender-ref ref="ForestBaseRollingFile"/>
            <!--            <appender-ref ref="ForestBaseCacheFile"/>-->
        </Async>
        <Async name="AsyncException">
            <appender-ref ref="ForestExceptionConsole"/>
            <appender-ref ref="ForestExceptionRollingFile"/>
            <!--            <appender-ref ref="ForestExceptionCacheFile"/>-->
        </Async>
    </Appenders>
    <!-- =============================================================== Loggers ============================================================== -->
    <!--然后定义logger，只有定义了logger并引入的appender，appender才会生效 -->
    <Loggers>
        <!--建立一个默认的root的logger(打印框架信息) -->
        <Root level="INFO">
            <appender-ref ref="AsyncFrameWork"/>
        </Root>
        <!-- 打印启动LOGO - WARN -->
        <AsyncLogger name="ForestInnerLogger" level="INFO" additivity="false" includeLocation="true">
            <appender-ref ref="AsyncInner"/>
        </AsyncLogger>
        <!-- 打印普通信息的Logger -->
        <AsyncLogger name="ForestAsyncLogger" level="INFO" additivity="false" includeLocation="true">
            <appender-ref ref="AsyncBase"/>
        </AsyncLogger>
        <!-- 打印异常信息的Logger -->
        <AsyncLogger name="ForestAsyncExceptionLogger" level="${EXCEPTION_LEVEL_LOWEST}" additivity="false"
                     includeLocation="true">
            <appender-ref ref="AsyncException"/>
        </AsyncLogger>
    </Loggers>
</Configuration>