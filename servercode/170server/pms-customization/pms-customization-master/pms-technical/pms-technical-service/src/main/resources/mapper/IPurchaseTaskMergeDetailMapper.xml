<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.IPurchaseTaskMergeDetailDao">



    <sql id="columns">
        primary_key, batch_num, product_category, own_part,total_demand,expect_arridate,
                   post_task_type,post_task_code,enterprise_code
    </sql>

    <insert id="addPurchaseTaskMergeDetails">
        INSERT INTO ${tableName} (<include refid="columns"/>)
        VALUES

        <foreach collection="taskMergeDetails" index="index" item="model" separator=",">
            (
            #{model.purchaseTaskMergeDetailCode}, #{model.batchNum}, #{model.productCategory}, #{model.ownPart}, #{model.totalDemand},
            #{model.expectArridate},
            #{model.postTaskType}, #{model.postTaskCode},#{model.enterpriseCode}
            )
        </foreach>
    </insert>


</mapper>