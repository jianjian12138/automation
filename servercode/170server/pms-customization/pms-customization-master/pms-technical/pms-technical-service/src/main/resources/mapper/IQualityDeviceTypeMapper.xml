<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.IQualityDeviceTypeMapper">
    <resultMap id="resultMap" type="com.futurecraftsmen.pms.technical.service.domain.quality.QualityDeviceTypeModel">
        <id property="primaryKey" column="primary_key" />
        <result property="name" column="qualit_device_type_sign" />
        <result property="ownedEnterpriseCode" column="enterprise_code" />
        <result property="deleteFlag" column="delete_flag" />
    </resultMap>

    <sql id="columns">
        primary_key, qualit_device_type_sign, enterprise_code, delete_flag
    </sql>

    <select id="findByCodes" resultMap="resultMap">
        SELECT <include refid="columns" />
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
            AND delete_flag = false
            AND primary_key IN
                <foreach collection="primaryKeys" item="primaryKey" open="(" close=")" separator=",">
                    #{primaryKey}
                </foreach>
    </select>

    <select id="queryByDeviceTypeNames" resultMap="resultMap">
        SELECT <include refid="columns" />
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        AND delete_flag = false
        AND qualit_device_type_sign IN
        <foreach collection="deviceTypeNameNeedQuery" item="deviceTypeName" open="(" close=")" separator=",">
            #{deviceTypeName}
        </foreach>
    </select>

    <select id="getQualityDeviceTypeAll"
            resultType="com.futurecraftsmen.pms.technical.api.domain.technical.equipmenttype.QualityDeviceTypeDTO">
        select
        primary_key qualityDeviceTypeCode,
        qualit_device_type_sign qualityDeviceTypeSign,
        delete_flag deleteFlag
        from ${tableName}
        where
        enterprise_code = #{enterpriseCode}
        <if test="requestData.qualityDeviceTypeCode != null">
            and primary_key = #{requestData.qualityDeviceTypeCode}
        </if>
        <if test="requestData.qualityDeviceTypeSign != null and requestData.qualityDeviceTypeSign !='' ">
            and qualit_device_type_sign like '%'|| #{requestData.qualityDeviceTypeSign} ||'%'
        </if>
        <if test="requestData.deleteFlag != null">
            and delete_flag = #{requestData.deleteFlag}
        </if>
        order by id
    </select>

    <select id="getQualityDeviceTypeBySign" resultType="int">
        select count(1)
        from ${tableName}
        where delete_flag = false
        and enterprise_code = #{enterpriseCode}
        <if test="qualityDeviceTypeSign != null and qualityDeviceTypeSign != ''">
            and primary_key = #{qualityDeviceTypeSign}
        </if>
    </select>
</mapper>