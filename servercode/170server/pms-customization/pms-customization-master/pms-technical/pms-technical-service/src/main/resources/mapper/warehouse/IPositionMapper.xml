<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.warehouse.IPositionMapper">
    <resultMap id="positionModel"
               type="com.futurecraftsmen.pms.technical.service.domain.warehouse.PositionModel">
        <result property="positionCode" column="primary_key"/>
        <result property="enterpriseCode" column="enterprise_code"/>
        <result property="enterTimr" column="enter_timr"/>
        <result property="remark" column="remark"/>
        <result property="chargeStaff" column="charge_staff"/>
        <result property="state" column="state"/>
        <result property="positionName" column="position_sign"/>
        <result property="warehorse" column="warehorse"/>
        <result property="type" column="type"/>
        <result property="updateTime" column="update_time"/>
        <result property="createTime" column="create_time"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>

    <select id="getPositionsByCodeList" resultMap="positionModel">
        SELECT primary_key,
        enterprise_code,
        enter_timr,
        remark,
        charge_staff,
        state,
        position_sign,
        type,
        update_time,
        create_time,
        delete_flag,
        warehorse
        FROM ${tableName}
        WHERE delete_flag = false
        AND state = true
        AND enterprise_code = #{enterpriseCode}
        <if test="codeList!= null and codeList.size()>0">
            AND primary_key IN
            <foreach collection="codeList" index="index" item="positionCode" open="(" separator="," close=")">
                #{positionCode}
            </foreach>
        </if>
    </select>

    <select id="getPositionsByNameList" resultMap="positionModel">
        SELECT primary_key,
        enterprise_code,
        enter_timr,
        remark,
        charge_staff,
        state,
        warehorse,
        position_sign,
        type,
        update_time,
        create_time,
        delete_flag
        FROM ${tableName}
        WHERE delete_flag = false
        AND state = true
        AND enterprise_code = #{enterpriseCode}
        AND position_sign IN
        <foreach collection="nameList" index="index" item="positionSign" open="(" separator="," close=")">
            #{positionSign}
        </foreach>
    </select>

    <select id="getWarehorseByNameList" resultMap="positionModel">
        SELECT primary_key,
        enterprise_code,
        enter_timr,
        remark,
        charge_staff,
        state,
        warehorse,
        position_sign,
        type,
        update_time,
        create_time,
        delete_flag
        FROM ${tableName}
        WHERE delete_flag = false
        AND state = true
        AND enterprise_code = #{enterpriseCode}
        AND warehorse IN
        <foreach collection="nameList" index="index" item="warehorse" open="(" separator="," close=")">
            #{warehorse}
        </foreach>
    </select>
</mapper>