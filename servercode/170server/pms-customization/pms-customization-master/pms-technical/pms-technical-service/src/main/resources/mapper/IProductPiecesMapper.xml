<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.IPiecesMapper">
    <!--Mybaits Code Help Pro XML增强插件，如果报错提示可以指定具体表名，只要结构对的上，解析没毛病-->
    <!--$var tableName=dm_m9.technology_t_dm_m9_pieces_9 -->
    <select id="queryByPrimaryKeys"
            resultType="com.futurecraftsmen.pms.technical.service.domain.product.ProductPieceModel">
        SELECT
        primary_key,
        pieces_sign as piecesSign,
        pcs_en as pcsEn,
        enterprise_code
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        <if test="primaryKeys!=null and !primaryKeys.isEmpty()">
            AND primary_key IN
            <foreach collection="primaryKeys" index="index" item="primaryKey" open="(" separator="," close=")">
                #{primaryKey}
            </foreach>
        </if>
        AND delete_flag = 'f'
    </select>
    <!--Mybaits Code Help Pro XML增强插件，如果报错提示可以指定具体表名，只要结构对的上，解析没毛病-->
    <!--$var tableName=dm_m9.technology_t_dm_m9_pieces_9 -->
    <select id="optionalProductPieces"
            resultType="com.futurecraftsmen.pms.technical.service.domain.product.ProductPieceModel">
        SELECT primary_key,
               pieces_sign AS piecesSign,
               pcs_en      AS pcsEn,
               enterprise_code,
               remark,
               creator,
               create_time
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        <if test="keyword != null and keyword != ''">
            AND (pieces_sign LIKE CONCAT('%', #{keyword}, '%')
                OR pcs_en LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="startDate != null and startDate != ''">
            AND create_time <![CDATA[ >= ]]> #{startDate}:: date + '00:00:00':: time
        </if>
        <if test="endDate != null and endDate != ''">
            AND create_time <![CDATA[ <= ]]> #{endDate}:: date + '23:59:59':: time
        </if>
        <if test="creatorList != null and !creatorList.isEmpty()">
            AND creator IN
            <foreach collection="creatorList" index="index" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>

        AND delete_flag = 'f'
        ORDER BY create_time DESC
    </select>

    <select id="queryAllPieceNames" resultType="java.lang.String">
        SELECT pieces_sign
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
          AND delete_flag = 'f'
    </select>

    <select id="queryByPieceNames"
            resultType="com.futurecraftsmen.pms.technical.service.domain.product.ProductPieceModel">
        SELECT
        primary_key,
        pieces_sign as piecesSign,
        pcs_en as pcsEn,
        enterprise_code
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        <if test="pieceNames!=null and !pieceNames.isEmpty()">
            AND pieces_sign IN
            <foreach collection="pieceNames" index="index" item="pieceName" open="(" separator="," close=")">
                #{pieceName}
            </foreach>
        </if>
        AND delete_flag = 'f'
    </select>
</mapper>