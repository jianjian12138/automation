<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.IProcedureChangeMapper">
    <resultMap id="resultMap" type="com.futurecraftsmen.pms.technical.service.domain.procedure.ProcedureChangeModel">
        <id property="primaryKey" column="primary_key" />
        <result property="procedureCode" column="procedure_code" />
        <result property="operator" column="operator" />
        <result property="operationDate" column="operation_date" />
        <result property="change" column="change" />
        <result property="originalNature" column="original_nature" />
        <result property="changeReason" column="change_reason" />
        <result property="ownedEnterpriseCode" column="enterprise_code" />
    </resultMap>

    <sql id="columns">
        primary_key, procedure_code, operator, operation_date, change, original_nature, change_reason
    </sql>

    <select id="page" resultMap="resultMap">
        SELECT <include refid="columns" />
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
            AND procedure_code = #{procedureCode}
            AND delete_flag = false
        ORDER BY create_time DESC
    </select>

</mapper>