<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.IActualCheckItemMapper">

    <resultMap id="resultMap" type="com.futurecraftsmen.pms.technical.service.domain.checkitem.ActualCheckItemModel">
        <id property="actualCheckItemCode" column="primary_key" />
        <result property="checkItemCode" column="check_item" />
        <result property="otherRequirement" column="other_requirement"/>
        <result property="sort" column="sort"/>
        <result property="ownedEnterpriseCode" column="enterprise_code" />
        <result property="deleteFlag" column="delete_flag" />
    </resultMap>

    <sql id="columns">
        primary_key, check_item, other_requirement,sort, enterprise_code, delete_flag
    </sql>


    <delete id="deleteByCodes">
        DELETE FROM ${tableName}
        WHERE  primary_key IN
        <foreach collection="primaryKeys" item="primaryKey" open="(" close=")" separator=",">
            #{primaryKey}
        </foreach>
          and enterprise_code = #{enterpriseCode}
          and delete_flag = false
    </delete>


    <insert id="batchAdd">
        INSERT INTO ${tableName} (primary_key, check_item,other_requirement,sort,enterprise_code)
        VALUES
        <foreach collection="actualCheckItemModels" index="index" item="model" separator=",">
            ( #{model.actualCheckItemCode}, #{model.checkItemCode}, #{model.otherRequirement},
            #{model.sort},
            #{model.ownedEnterpriseCode})
        </foreach>
    </insert>


    <select id="findByCodes" resultMap="resultMap">
        SELECT <include refid="columns"/>
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        AND delete_flag = false
        AND primary_key IN
        <foreach collection="primaryKeys" item="primaryKey" open="(" close=")" separator=",">
            #{primaryKey}
        </foreach>
        ORDER BY sort
    </select>

</mapper>