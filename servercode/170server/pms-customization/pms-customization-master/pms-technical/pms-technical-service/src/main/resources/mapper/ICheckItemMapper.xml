<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.technical.service.dao.ICheckItemMapper">
    <resultMap id="resultMap" type="com.futurecraftsmen.pms.technical.service.domain.checkitem.CheckItemModel">
        <id property="primaryKey" column="primary_key" />
        <result property="name" column="check_item_sign" />
        <result property="method" column="method"/>
        <result property="deviceTypes" column="device_types" jdbcType="ARRAY"
                typeHandler="com.futurecraftsmen.pms.service.domain.ArrayTypeHandler"/>
        <result property="requirement" column="requirement"/>
        <result property="relatedFile" column="related_file" jdbcType="ARRAY"
                typeHandler="com.futurecraftsmen.pms.service.domain.ArrayTypeHandler"/>
        <result property="enable" column="enable"/>
        <result property="contact" column="contact"/>
        <result property="creator" column="creator"/>
        <result property="remark" column="remark"/>
        <result property="ownedEnterpriseCode" column="enterprise_code" />
        <result property="deleteFlag" column="delete_flag" />
    </resultMap>

    <sql id="columns">
        primary_key, check_item_sign, method, device_types::BIGINT[], requirement, related_file::BIGINT[], enable, contact, creator, remark, enterprise_code, delete_flag
    </sql>




    <select id="page" resultMap="resultMap">
        SELECT <include refid="columns"/>
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        AND delete_flag = false
        <if test="enable != null">
            AND enable = #{enable}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="findByCodes" resultMap="resultMap">
        SELECT <include refid="columns"/>
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
        AND delete_flag = false
        AND primary_key IN
        <foreach collection="primaryKeys" item="primaryKey" open="(" close=")" separator=",">
            #{primaryKey}
        </foreach>
    </select>
</mapper>