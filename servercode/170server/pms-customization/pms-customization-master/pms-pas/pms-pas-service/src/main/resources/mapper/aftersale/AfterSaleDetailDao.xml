<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.futurecraftsmen.pms.pas.service.dao.aftersale.AfterSaleDetailDao">


    <resultMap id="AfterSaleDetailModel"
               type="com.futurecraftsmen.pms.pas.service.po.aftersale.AfterSaleDetailModel">
        <result column="primary_key" property="afterSaleDetailCode"/>
        <result column="feedback_detail_code" property="feedbackDetailCode"/>
        <result column="after_sale_code" property="afterSaleCode"/>
        <result column="sell_contract" property="sellContract"/>
        <result column="contract_product" property="contractProduct"/>
        <result column="name" property="name"/>
        <result column="model" property="model"/>
        <result column="material_code" property="materialCode"/>
        <result column="contract_quantity" property="contractQuantity"/>
        <result column="feedback_num" property="feedbackNum"/>
        <result column="pcs_in_contract" property="pcsInContract"/>
        <result column="demand" property="demand"/>
        <result column="feedback_time" property="feedbackTime"/>
        <result column="result" property="result"/>
        <result column="handle_time" property="handleTime"/>
        <result column="create_time" property="createTime"/>
        <result column="enterprise_code" property="enterpriseCode"/>
    </resultMap>

    <insert id="addAfterSaleDetails">
        INSERT INTO ${tableName}
        (primary_key,feedback_detail_code, after_sale_code,sell_contract,contract_product,
        name,model,material_code,contract_quantity,
        feedback_num,pcs_in_contract,demand,feedback_time,
        result,handle_time,enterprise_code)
        VALUES
        <foreach collection="models" index="index" item="model" separator=",">
            ( #{model.afterSaleDetailCode}, #{model.feedbackDetailCode}, #{model.afterSaleCode},#{model.sellContract},
            #{model.contractProduct},
            #{model.name},#{model.model},#{model.materialCode},#{model.contractQuantity},
            #{model.feedbackNum},#{model.pcsInContract},#{model.demand},#{model.feedbackTime},
            #{model.result},#{model.handleTime},#{model.enterpriseCode})
        </foreach>
    </insert>


    <select id="detailPage" resultMap="AfterSaleDetailModel">
        SELECT primary_key,
               feedback_detail_code,
               after_sale_code,
               sell_contract,
               contract_product,
               name,
               model,
               material_code,
               contract_quantity,
               feedback_num,
               pcs_in_contract,
               demand,
               feedback_time,
               result,
               handle_time,
               enterprise_code
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
          AND delete_flag = 'f'
          AND after_sale_code = #{afterSaleCode}
        ORDER BY contract_product, feedback_time DESC
    </select>


    <update id="updateAfterHandle">
        UPDATE ${tableName}
        SET result      = #{result},
            handle_time = #{handleTime}
        WHERE enterprise_code = #{enterpriseCode}
          AND delete_flag = 'f'
          AND after_sale_code = #{afterSaleCode}
          AND result IS NULL
          AND handle_time IS NULL
    </update>

    <select id="queryUnHandledData" resultMap="AfterSaleDetailModel">
        SELECT primary_key,
               feedback_detail_code,
               after_sale_code,
               sell_contract,
               contract_product,
               name,
               model,
               material_code,
               contract_quantity,
               feedback_num,
               pcs_in_contract,
               demand,
               feedback_time,
               result,
               handle_time,
               enterprise_code
        FROM ${tableName}
        WHERE enterprise_code = #{enterpriseCode}
          AND delete_flag = 'f'
          AND after_sale_code = #{afterSaleCode}
          AND result IS NULL
          AND handle_time IS NULL
    </select>


</mapper>