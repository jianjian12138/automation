    <!-- 批量插入新记�?-->
    <insert id="addTasks">
        INSERT INTO ${tableName} (primary_key,
                                  enterprise_code,
                                  procedure_code,
                                  procedure_name,
                                  operator_user_code,
                                  task_num,
                                  overdue_date,
                                  should_inspect_num,
                                  status,
                                  remark,
                                  main_id,
                                  batch_num,
                                  model,
                                  pcs_name,
                                  related_name,
                                  related_code,
                                  related_type,
                                  product_or_part,
                                  product_or_part_name,
                                  receive_num,
                                  report_batch_no,
                                  buss_number,
                                  contract_code,
                                  check_items,
                                  contract_quantity,
        self_receiving_detail,receiving_detail,batch,product_flag,batch_global_code)
        VALUES
        <foreach collection="models" index="index" item="data" separator=",">
            (#{data.primaryKeyValue},
                #{data.enterpriseCode},
                #{data.procedureCode},
                #{data.procedureName},
                #{data.operatorUserCode},
                #{data.taskNum},
                #{data.overdueDate},
                #{data.shouldInspectNum},
                #{data.status},
                #{data.remark},
                #{data.mainId},
                #{data.batchNum},
                #{data.model},
                #{data.pcsName},
                #{data.relatedName},
                #{data.relatedCode},
                #{data.relatedType},
                #{data.productOrPart},
                #{data.productOrPartName},
                #{data.receiveNum},
                #{data.reportBatchNo},
                #{data.bussNumber},
                #{data.contractCode},
                #{data.checkItems},
                #{data.contractQuantity},
            #{data.selfReceivingDetail},
            #{data.receivingDetail},
            #{data.batch},
            #{data.productFlag}, #{data.batchGlobalCode})
        </foreach>
    </insert>

</mapper>
